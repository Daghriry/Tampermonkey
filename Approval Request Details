    // =========================================================
    // CATEGORY
    // =========================================================

    function detectCategory(
        itemName,
        requestType,
        sections,
        accessories
    ) {
        const item =
            normalize(itemName);

        if (isOnboarding(itemName)) {
            return 'onboarding';
        }

        if (
            isOwnershipTransfer(
                itemName
            )
        ) {
            return 'ownership';
        }

        if (
            isNonStandard(
                requestType
            ) ||
            sections.some(section =>
                normalize(section.label)
                    .includes(
                        'non-standard hardware'
                    )
            )
        ) {
            return 'nonstandard';
        }

        if (
            accessories.length > 0 ||
            requestType === 'accessories' ||
            requestType.includes(
                'accessor'
            )
        ) {
            return 'accessories';
        }

        if (
            item.includes('software') ||
            requestType.includes(
                'software'
            ) ||
            sections.some(section =>
                normalize(section.label)
                    .includes(
                        'business justification'
                    )
            )
        ) {
            return 'software';
        }

        if (
            item.includes('hardware') ||
            requestType.includes(
                'hardware'
            ) ||
            sections.some(section =>
                normalize(section.label)
                    .includes(
                        'description/justification'
                    )
            )
        ) {
            return 'hardware';
        }

        return 'other';
    }


    // =========================================================
