    function clean(value) {
        return String(value || '')
            .replace(/\u00a0/g, ' ')
            .replace(/\r\n/g, '\n')
            .replace(/\r/g, '\n')
            .replace(/[ \t]+/g, ' ')
            .replace(/\n{3,}/g, '\n\n')
            .trim();
    }


    function normalize(value) {
        return clean(value)
            .replace(/\*/g, '')
            .replace(/[؟?]+$/g, '')
            .replace(/\s*\/\s*/g, '/')
            .replace(/\s+/g, ' ')
            .toLowerCase()
            .trim();
    }


    function isGarbage(value) {
        const text = clean(value);

        return (
            !text ||
            /^[a-f0-9]{32}$/i.test(text) ||
            /^[a-f0-9]{40,}$/i.test(text) ||
            /^(null|undefined)$/i.test(text)
        );
    }


    function isEmptyChoice(value) {
        const text = normalize(value);

        return (
            !text ||
            text === '-- none --' ||
            text === '--none--' ||
            text === 'none' ||
            text === '(empty)'
        );
    }


    function unique(values) {
        return Array.from(
            new Set(
                values
                    .map(clean)
                    .filter(Boolean)
            )
        );
    }


    // =========================================================
    // FIELD EXTRACTION
    // =========================================================

    function readField(field) {
        if (!field) {
            return '';
        }

        if (field.tagName === 'SELECT') {
            const selected = Array.from(
                field.selectedOptions || []
            )
                .map(option =>
                    clean(option.textContent)
                )
                .filter(value =>
                    !isEmptyChoice(value)
                );

            if (selected.length) {
                return selected.join(', ');
            }

            return clean(field.value);
        }

        if (
            field.tagName === 'INPUT' &&
            field.type === 'checkbox'
        ) {
            return field.checked ? 'Yes' : '';
        }

        if (
            field.tagName === 'INPUT' &&
            field.type === 'radio'
        ) {
            return field.checked
                ? clean(field.value)
                : '';
        }

        const value = clean(
            field.value ||
            field.getAttribute('value') ||
            field.textContent ||
            ''
        );

        return isGarbage(value)
            ? ''
            : value;
    }


    function findVariableLabel(
        doc,
        searchText
    ) {
        const wanted =
            normalize(searchText);

        const labels =
            Array.from(
                doc.querySelectorAll('label')
            );

        let label =
            labels.find(item =>
                normalize(
                    item.innerText ||
                    item.textContent
                ) === wanted
            );

        if (!label) {
            label =
                labels.find(item =>
                    normalize(
                        item.innerText ||
                        item.textContent
                    ).includes(wanted)
                );
        }

        return label || null;
    }


    function getVariable(
        doc,
        searchText
    ) {
        const label =
            findVariableLabel(
                doc,
                searchText
            );

        if (!label) {
            return null;
        }

        const fieldId =
            label.getAttribute('for');

        let value = '';

        if (fieldId) {
            value =
                readField(
                    doc.getElementById(fieldId)
                );

            if (!value) {
                value =
                    readField(
                        doc.getElementById(
                            'sys_original.' +
                            fieldId
                        )
                    );
            }
        }

        if (!value) {
            const containers = [
                label.closest('.form-group'),
                label.closest('.question'),
                label.closest('.cat_item_option'),
                label.closest('td'),
                label.closest('tr'),
                label.parentElement
            ].filter(Boolean);

            for (const container of containers) {
                const fields =
                    container.querySelectorAll(
                        'textarea,input,select'
                    );

                for (const field of fields) {
                    const candidate =
                        readField(field);

                    if (candidate) {
                        value = candidate;
                        break;
                    }
                }

                if (value) {
                    break;
                }
            }
        }

        if (
            !value ||
            isGarbage(value)
        ) {
            return null;
        }

        return {
            label: clean(
                label.innerText ||
                label.textContent
            ),
            value
        };
    }


    function getFirstVariable(
        doc,
        names
    ) {
        for (const name of names) {
            const result =
                getVariable(
                    doc,
                    name
                );

            if (
                result &&
                !isEmptyChoice(
                    result.value
                )
            ) {
                return result;
            }
        }

        return null;
    }


    function collectSections(
        doc,
        mappings
    ) {
        const sections = [];

        mappings.forEach(mapping => {
            const result =
                getFirstVariable(
                    doc,
                    mapping.names
                );

            if (
                !result ||
                isEmptyChoice(
                    result.value
                )
            ) {
                return;
            }

            sections.push({
                label: mapping.label,
                value: result.value,
                type: 'text'
            });
        });

        return sections;
    }


    function removeDuplicates(sections) {
        const seen = new Set();

        return sections.filter(section => {
            const value =
                Array.isArray(section.value)
                    ? section.value.join('|')
                    : section.value;

            const key =
                normalize(section.label) +
                '|' +
                normalize(value);

            if (seen.has(key)) {
                return false;
            }

            seen.add(key);
            return true;
        });
    }


