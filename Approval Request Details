    // =========================================================

    function parseRitm(html) {
        const doc =
            new DOMParser()
                .parseFromString(
                    html,
                    'text/html'
                );

        const title =
            normalize(doc.title);

        const bodyText =
            normalize(
                doc.body?.textContent
            );

        if (
            title.includes('login') ||
            bodyText.includes(
                'your session has expired'
            )
        ) {
            throw new Error(
                'SESSION_EXPIRED'
            );
        }

        const itemName =
            getItemName(doc);

        const requestType =
            getRequestType(doc);

        const beneficiary =
            extractBeneficiary(doc);

        const accessories =
            extractAccessories(doc);

        let sections = [];

        if (isOnboarding(itemName)) {
            sections =
                extractOnboarding(doc);

        } else if (
            isOwnershipTransfer(
                itemName
            )
        ) {
            sections =
                extractOwnershipTransfer(
                    doc
                );

        } else if (
            isNonStandard(
                requestType
            )
        ) {
            sections =
                extractNonStandard(doc);
        }

        addJustification(
            sections,
            extractJustification(doc)
        );

        if (accessories.length > 0) {
            sections.push({
                label: 'Accessories',
                value: accessories,
                type: 'accessories'
            });
        }

        sections =
            removeDuplicates(
                sections
            );

        const category =
            detectCategory(
                itemName,
                requestType,
                sections,
                accessories
            );

        const typeInfo =
            REQUEST_TYPES[category] ||
            REQUEST_TYPES.other;

        return {
            itemName,
            requestType,
            beneficiary,
            category,
            typeLabel: typeInfo.label,
            typeClass: typeInfo.className,
            sections
        };
    }


    // =========================================================
    // FETCH
    // =========================================================

    function getSysId(url) {
        try {
            return new URL(
                url,
                window.location.origin
            )
                .searchParams
                .get('sys_id') || '';

        } catch {
            return '';
        }
    }


    function buildRitmUrl(url) {
        const sysId =
            getSysId(url);

        if (
            !/^[a-f0-9]{32}$/i
                .test(sysId)
        ) {
            return '';
        }

        return (
            window.location.origin +
            '/sc_req_item.do' +
            '?sys_id=' +
            encodeURIComponent(sysId) +
            '&sysparm_view=sow'
        );
    }


    async function loadRitm(url) {
        if (
            requestCache.has(url)
        ) {
            return requestCache.get(
                url
            );
        }

        const response =
            await fetch(
                url,
                {
                    credentials:
                        'same-origin',

                    cache:
                        'no-store',

                    redirect:
                        'follow',

                    headers: {
                        Accept:
                            'text/html,application/xhtml+xml'
                    }
                }
            );

        if (!response.ok) {
            throw new Error(
                'HTTP_' +
                response.status
            );
        }

        const finalUrl =
            response.url || '';

        if (
            finalUrl.includes('login') ||
            finalUrl.includes('sso') ||
            finalUrl.includes(
                'auth_redirect'
            )
        ) {
            throw new Error(
                'SESSION_EXPIRED'
            );
        }

        const result =
            parseRitm(
                await response.text()
            );

        requestCache.set(
            url,
            result
        );

        return result;
    }


    // =========================================================
    // RENDERING
    // =========================================================

    function clearTypeClasses(cell) {
        Object.values(
            REQUEST_TYPES
        )
            .forEach(type =>
                cell.classList.remove(
                    type.className
                )
            );
    }


    function showLoading(
        detailsCell,
        beneficiaryCell,
        ritm
    ) {
        clearTypeClasses(
            detailsCell
        );

        detailsCell.replaceChildren();
        beneficiaryCell.replaceChildren();

        const wrapper =
            document.createElement('span');

        wrapper.className =
            'tm-loading';

        const spinner =
            document.createElement('span');

        spinner.className =
            'tm-spinner';

        const text =
            document.createElement('span');

        text.textContent =
            ritm
                ? 'Loading ' + ritm + '...'
                : 'Loading...';

        wrapper.append(
            spinner,
            text
        );

        detailsCell.appendChild(
            wrapper
        );

        beneficiaryCell.textContent =
            'Loading...';
    }


    function createTypeHeader(result) {
        const header =
            document.createElement('div');

        header.className =
            'tm-type-header';

        const badge =
            document.createElement('span');

        badge.className =
            'tm-type-badge';

        badge.textContent =
            result.typeLabel;

        header.appendChild(badge);

        return header;
    }


    function createTextSection(
        labelText,
        valueText
    ) {
        const section =
            document.createElement('div');

        section.className =
            'tm-detail-section';

        const label =
            document.createElement('span');

        label.className =
            'tm-detail-label';

        label.textContent =
            labelText;

        const value =
            document.createElement('span');

        value.className =
            'tm-detail-value';

        value.textContent =
            valueText;

        value.title =
            valueText;

        section.append(
            label,
            value
        );

        return section;
    }


    function createAccessoriesSection(
        accessories
    ) {
        const section =
            document.createElement('div');

        section.className =
            'tm-detail-section';

        const label =
            document.createElement('span');

        label.className =
            'tm-detail-label';

        label.textContent =
            'Accessories';

        const list =
            document.createElement('ul');

        list.className =
            'tm-accessory-list';

        accessories.forEach(accessory => {
            const item =
                document.createElement('li');

            item.className =
                'tm-accessory-item';

            item.textContent =
                accessory;

            list.appendChild(item);
        });

        section.append(
            label,
            list
        );

        return section;
    }


    function showResult(
        detailsCell,
        beneficiaryCell,
        result
    ) {
        detailsCell.replaceChildren();
        beneficiaryCell.replaceChildren();

        clearTypeClasses(
            detailsCell
        );

        detailsCell.classList.add(
            result.typeClass
        );

        detailsCell.appendChild(
            createTypeHeader(result)
        );

        if (result.beneficiary) {
            const name =
                document.createElement('span');

            name.className =
                'tm-beneficiary-name';

            name.textContent =
                result.beneficiary;

            beneficiaryCell.appendChild(
                name
            );

        } else {
            const empty =
                document.createElement('span');

            empty.className =
                'tm-empty';

            empty.textContent =
                'Not available';

            beneficiaryCell.appendChild(
                empty
            );
        }

        if (
            !result.sections ||
            result.sections.length === 0
        ) {
            const empty =
                document.createElement('span');

            empty.className =
                'tm-empty';

            empty.textContent =
                'No request details found';

            detailsCell.appendChild(
                empty
            );

            return;
        }

        result.sections.forEach(section => {
            if (
                section.type ===
                'accessories'
            ) {
                detailsCell.appendChild(
                    createAccessoriesSection(
                        section.value
                    )
                );

                return;
            }

            detailsCell.appendChild(
                createTextSection(
                    section.label,
                    section.value
                )
            );
        });
    }


    function showError(
        detailsCell,
        beneficiaryCell,
        error,
        job
    ) {
        detailsCell.replaceChildren();
        beneficiaryCell.replaceChildren();

        clearTypeClasses(
            detailsCell
        );

        const message =
            document.createElement('span');

        message.className =
            'tm-error';

        message.textContent =
            error?.message ===
            'SESSION_EXPIRED'
                ? 'Session expired or redirected to login'
                : 'Unable to load request details';

        const retry =
            document.createElement('button');

        retry.type = 'button';
        retry.className = 'tm-retry';
        retry.textContent = 'Retry';

        retry.addEventListener(
            'click',
            () => {
                requestCache.delete(
                    job.ritmUrl
                );

                showLoading(
                    job.detailsCell,
                    job.beneficiaryCell,
                    job.ritm
                );

                requestQueue.push(job);

                processQueue();
            }
        );

        detailsCell.append(
            message,
            document.createElement('br'),
            retry
        );

        beneficiaryCell.textContent =
            'Unable to load';
    }


    // =========================================================
    // LIST STRUCTURE
    // =========================================================

    function findApprovalHeader(table) {
        const rows =
            Array.from(
                table.querySelectorAll(
                    'thead tr'
                )
            );

        for (const row of rows) {
            const cells =
                Array.from(
                    row.querySelectorAll(
                        ':scope > th, :scope > td'
                    )
                );

            const header =
                cells.find(cell => {
                    if (
                        cell.classList.contains(
                            DETAILS_CLASS
                        ) ||
                        cell.classList.contains(
                            BENEFICIARY_CLASS
                        )
                    ) {
                        return false;
                    }

                    const name =
                        String(
                            cell.getAttribute('name') ||
                            ''
                        )
                            .toLowerCase();

                    const text =
                        normalize(
                            cell.textContent
                        );

                    return (
                        name === 'sysapproval' ||
                        text === 'approval for'
                    );
                });

            if (header) {
                return header;
            }
        }

        return null;
    }


    function findApprovalCell(row) {
        const cells =
            Array.from(
                row.querySelectorAll(
                    ':scope > td'
                )
            )
                .filter(cell =>
                    !cell.classList.contains(
                        DETAILS_CLASS
                    ) &&
                    !cell.classList.contains(
                        BENEFICIARY_CLASS
                    )
                );

        let cell =
            cells.find(item => {
                const name =
                    String(
                        item.getAttribute('name') ||
                        ''
                    )
                        .toLowerCase();

                const element =
                    String(
                        item.getAttribute(
                            'data-element'
                        ) || ''
                    )
                        .toLowerCase();

                return (
                    name === 'sysapproval' ||
                    element === 'sysapproval'
                );
            });

        if (cell) {
            return cell;
        }

        cell =
            cells.find(item =>
                Array.from(
                    item.querySelectorAll(
                        'a[href]'
                    )
                )
                    .some(link => {
                        const href =
                            String(
                                link.getAttribute('href') ||
                                ''
                            );

                        const text =
                            clean(link.textContent);

                        return (
                            href.includes(
                                'sc_req_item.do'
                            ) ||
                            /^RITM\d+$/i.test(text) ||
                            text.includes(
                                'Requested Item: RITM'
                            )
                        );
                    })
            );

        if (cell) {
            return cell;
        }

        return cells.find(item =>
            /\bRITM\d+\b/i.test(
                clean(item.textContent)
            )
        ) || null;
    }


    function findRitmLink(row) {
        const links =
            Array.from(
                row.querySelectorAll(
                    'a[href]'
                )
            );

        let link =
            links.find(item =>
                String(
                    item.getAttribute('href') ||
                    ''
                )
                    .includes(
                        'sc_req_item.do'
                    )
            );

        if (link) {
            return link;
        }

        return links.find(item => {
            const href =
                String(
                    item.getAttribute('href') ||
                    ''
                );

            const text =
                clean(item.textContent);

            return (
                href.includes('task.do') &&
                /^RITM\d+$/i.test(text)
            );
        }) || null;
    }


    function getRitmNumber(row) {
        const match =
            clean(row.textContent)
                .match(/\bRITM\d+\b/i);

        return match
            ? match[0].toUpperCase()
            : '';
    }


    function createHeader(
        referenceHeader,
        className,
        title
    ) {
        const header =
            referenceHeader.cloneNode(false);

        header.removeAttribute('id');
        header.removeAttribute('name');
        header.removeAttribute(
            'data-element'
        );

        header.classList.add(className);
        header.innerHTML = '';

        const container =
            document.createElement('span');

        container.className =
            'list_header_cell_container';

        const text =
            document.createElement('span');

        text.className =
            'column_head table-col-header';

        text.textContent = title;

        container.appendChild(text);
        header.appendChild(container);

        return header;
    }


    function installHeaders(table) {
        const approvalHeader =
            findApprovalHeader(table);

        if (!approvalHeader) {
            return;
        }

        const row =
            approvalHeader.parentElement;

        let detailsHeader =
            row.querySelector(
                '.' + DETAILS_CLASS
            );

        let beneficiaryHeader =
            row.querySelector(
                '.' + BENEFICIARY_CLASS
            );

        if (!detailsHeader) {
            detailsHeader =
                createHeader(
                    approvalHeader,
                    DETAILS_CLASS,
                    DETAILS_TITLE
                );
        }

        if (!beneficiaryHeader) {
            beneficiaryHeader =
                createHeader(
                    approvalHeader,
                    BENEFICIARY_CLASS,
                    BENEFICIARY_TITLE
                );
        }

        approvalHeader.insertAdjacentElement(
            'afterend',
            detailsHeader
        );

        detailsHeader.insertAdjacentElement(
            'afterend',
            beneficiaryHeader
        );
    }


    function getApprovalIndex(table) {
        const approvalHeader =
            findApprovalHeader(table);

        if (!approvalHeader) {
            return -1;
        }

        const originalCells =
            Array.from(
                approvalHeader
                    .parentElement
                    .children
            )
                .filter(cell =>
                    !cell.classList.contains(
                        DETAILS_CLASS
                    ) &&
                    !cell.classList.contains(
                        BENEFICIARY_CLASS
                    )
                );

        return originalCells.indexOf(
            approvalHeader
        );
    }


    function installSearchColumns(table) {
        const approvalHeader =
            findApprovalHeader(table);

        if (!approvalHeader) {
            return;
        }

        const approvalIndex =
            getApprovalIndex(table);

        if (approvalIndex < 0) {
            return;
        }

        const headerRow =
            approvalHeader.parentElement;

        const searchRows =
            Array.from(
                table.querySelectorAll(
                    'thead tr'
                )
            )
                .filter(row =>
                    row !== headerRow &&
                    row.querySelector('input')
                );

        searchRows.forEach(row => {
            row.querySelectorAll(
                '.' +
                DETAILS_CLASS +
                ', .' +
                BENEFICIARY_CLASS
            )
                .forEach(cell =>
                    cell.remove()
                );

            const originalCells =
                Array.from(row.children)
                    .filter(cell =>
                        !cell.classList.contains(
                            DETAILS_CLASS
                        ) &&
                        !cell.classList.contains(
                            BENEFICIARY_CLASS
                        )
                    );

            const approvalCell =
                originalCells[
                    approvalIndex
                ];

            if (!approvalCell) {
                return;
            }

            const detailsCell =
                approvalCell.cloneNode(false);

            detailsCell.removeAttribute('id');
            detailsCell.removeAttribute('name');
            detailsCell.classList.add(
                DETAILS_CLASS
            );

            const beneficiaryCell =
                approvalCell.cloneNode(false);

            beneficiaryCell.removeAttribute('id');
            beneficiaryCell.removeAttribute('name');
            beneficiaryCell.classList.add(
                BENEFICIARY_CLASS
            );

            approvalCell.insertAdjacentElement(
                'afterend',
                detailsCell
            );

            detailsCell.insertAdjacentElement(
                'afterend',
                beneficiaryCell
            );
        });
    }


    function installRow(row) {
        const approvalCell =
            findApprovalCell(row);

        if (!approvalCell) {
            return;
        }

        let detailsCell =
            row.querySelector(
                'td.' + DETAILS_CLASS
            );

        let beneficiaryCell =
            row.querySelector(
                'td.' + BENEFICIARY_CLASS
            );

        if (!detailsCell) {
            detailsCell =
                approvalCell.cloneNode(false);

            detailsCell.removeAttribute('id');
            detailsCell.removeAttribute('name');
            detailsCell.removeAttribute(
                'data-element'
            );
            detailsCell.classList.add(
                DETAILS_CLASS
            );
        }

        if (!beneficiaryCell) {
            beneficiaryCell =
                approvalCell.cloneNode(false);

            beneficiaryCell.removeAttribute('id');
            beneficiaryCell.removeAttribute('name');
            beneficiaryCell.removeAttribute(
                'data-element'
            );
            beneficiaryCell.classList.add(
                BENEFICIARY_CLASS
            );
        }

        approvalCell.insertAdjacentElement(
            'afterend',
            detailsCell
        );

        detailsCell.insertAdjacentElement(
            'afterend',
            beneficiaryCell
        );

        if (
            detailsCell.dataset.tmLoaded ===
            'true'
        ) {
            return;
        }

        if (
            detailsCell.dataset.tmQueued ===
            'true'
        ) {
            return;
        }

        const ritmLink =
            findRitmLink(row);

        const ritm =
            getRitmNumber(row);

        if (!ritmLink) {
            detailsCell.textContent =
                'RITM not found';

            beneficiaryCell.textContent =
                'Not available';

            return;
        }

        const ritmUrl =
            buildRitmUrl(
                ritmLink.href
            );

        if (!ritmUrl) {
            detailsCell.textContent =
                'Invalid RITM';

            beneficiaryCell.textContent =
                'Not available';

            return;
        }

        detailsCell.dataset.tmQueued =
            'true';

        showLoading(
            detailsCell,
            beneficiaryCell,
            ritm
        );

        requestQueue.push({
            detailsCell,
            beneficiaryCell,
            ritm,
            ritmUrl
        });

        processQueue();
    }


    // =========================================================
    // QUEUE
    // =========================================================

    function processQueue() {
        while (
            activeRequests <
                MAX_CONCURRENT_REQUESTS &&
            requestQueue.length > 0
        ) {
            const job =
                requestQueue.shift();

            if (
                !job.detailsCell.isConnected ||
                !job.beneficiaryCell.isConnected
            ) {
                continue;
            }

            activeRequests++;

            loadRitm(job.ritmUrl)
                .then(result => {
                    if (
                        !job.detailsCell.isConnected
                    ) {
                        return;
                    }

                    showResult(
                        job.detailsCell,
                        job.beneficiaryCell,
                        result
                    );

                    job.detailsCell.dataset.tmLoaded =
                        'true';
                })

                .catch(error => {
                    console.error(
                        '[Request Details]',
                        job.ritm,
                        error
                    );

                    if (
                        job.detailsCell.isConnected
                    ) {
                        showError(
                            job.detailsCell,
                            job.beneficiaryCell,
                            error,
                            job
                        );
                    }
                })

                .finally(() => {
                    activeRequests--;
                    processQueue();
                });
        }
    }


    // =========================================================
    // TABLE SCANNING
    // =========================================================

    function getTable() {
        return (
            document.getElementById(
                TABLE_ID
            ) ||
            document.querySelector(
                'table[glide_table="sysapproval_approver"]'
            )
        );
    }


    function scan() {
        const table =
            getTable();

        if (!table) {
            return;
        }

        installStyles();
        installHeaders(table);
        installSearchColumns(table);

        table.querySelectorAll(
            'tbody tr.list_row'
        )
            .forEach(installRow);
    }


    function scheduleScan() {
        clearTimeout(scanTimer);

        scanTimer =
            setTimeout(
                scan,
                300
            );
    }


    function startObserver() {
        if (observerStarted) {
            return;
        }

        observerStarted = true;

        const observer =
            new MutationObserver(
                mutations => {
                    const relevant =
                        mutations.some(
                            mutation => {
                                const target =
                                    mutation.target;

                                if (
                                    target instanceof Element &&
                                    target.closest(
                                        '.' + DETAILS_CLASS +
                                        ', .' + BENEFICIARY_CLASS
                                    )
                                ) {
                                    return false;
                                }

                                return (
                                    mutation.addedNodes.length > 0 ||
                                    mutation.removedNodes.length > 0
                                );
                            }
                        );

                    if (relevant) {
                        scheduleScan();
                    }
                }
            );

        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true
            }
        );
    }


    // =========================================================
    // START
    // =========================================================

    function start() {
        scan();
        startObserver();

        setTimeout(scan, 700);
        setTimeout(scan, 1500);
        setTimeout(scan, 3000);
        setTimeout(scan, 5000);
    }


    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            start,
            {
                once: true
            }
        );

    } else {
        start();
    }

